# 이 파일을 .env로 복사해서 값을 채운다 (.env는 gitignore돼 있다).
# 셸에 이미 export된 값이 있으면 그쪽이 이긴다.

# 검색 임베딩 (기본 provider: openai)
OPENAI_API_KEY=sk-...
# WIKI_EMBED_PROVIDER=local     # fastembed 로컬 임베딩으로 되돌리기
# WIKI_EMBED_MODEL=text-embedding-3-small   # 비용을 6.5배 줄이는 대신 품질 하락
# WIKI_EMBED_DIM=1024           # 3072차원 대신 축소 (비용은 동일, 캐시 크기만 줄어든다)
# sensitivity: personal과 work 문서는 기본으로 API에 보낸다. confidential만 안 보내고
# BM25(로컬)로만 검색된다. 아래를 켜면 confidential 본문도 보낸다.
# WIKI_EMBED_SEND_SENSITIVE=1

# vault 위치 (셸의 $WIKI_VAULT가 이미 있으면 불필요)
# WIKI_VAULT=/Users/me/workspace/personal-wiki/wiki-vault

# 임베딩 API 엔드포인트를 바꿀 때만 (OpenAI 호환 프록시 등)
# WIKI_OPENAI_BASE_URL=https://api.openai.com/v1

# 임베딩 캐시 위치 (기본 ~/.cache/wiki-toolkit/fastembed). 벡터 캐시와 fastembed 가중치가
# 여기 산다. ~는 코드가 펼쳐 준다.
# WIKI_EMBED_CACHE=~/.cache/wiki-toolkit/fastembed
